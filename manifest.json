{
    "manifest_version": 3,
    "name": "Mixed Content Unblocker",
    "version": "1.0.1",
    "description": "Mengizinkan mixed content secara otomatis di browser.",
    "icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "permissions": ["declarativeNetRequest", "storage"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_start"
      }
    ],
    "declarative_net_request": {
      "rule_resources": [
        {
          "id": "block-csp",
          "enabled": true,
          "path": "rules.json"
        }
      ]
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "kang.tatang@yahoo.co.id"
      }
    }
  }
  